#!/bin/bash

# Point the running shell at this working tree, so edits here are the plugin.
#
# The shell discovers third-party plugins by globbing
# ~/.config/omarchy/plugins/*/ and reading manifest.json inside — a symlinked
# plugin directory satisfies that. A real install (`omarchy plugin add`) clones
# the repo into that directory instead; this is only for development.
#
# Symlinks *inside* a plugin folder are refused by the shell and by
# `omarchy plugin validate`. Linking the folder itself is fine, but keep
# running bin/check against this repo rather than the installed path.

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"

fail() {
  echo "dev-link: $*" >&2
  exit 1
}

"$ROOT/bin/check" >/dev/null || fail "manifest is invalid; run bin/check"

id=$(jq -r '.id' "$ROOT/manifest.json")
target="$PLUGINS_DIR/$id"

mkdir -p "$PLUGINS_DIR"

if [[ -e $target && ! -L $target ]]; then
  fail "$target exists and is not a symlink; remove it first"
fi

if [[ -L $target ]]; then
  current=$(readlink -f "$target")
  [[ $current == "$ROOT" ]] || fail "$target already points at $current"
else
  ln -s "$ROOT" "$target"
fi

# The shell scans asynchronously, so give it a moment before the plugin shows
# up in `omarchy plugin list`.
omarchy-shell shell rescanPlugins >/dev/null || echo "dev-link: rescan failed; is omarchy-shell running?" >&2
sleep 1

echo "dev-link: $target -> $ROOT"
echo "dev-link: enable it with 'omarchy plugin enable $id --section right'"
