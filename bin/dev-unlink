#!/bin/bash

# Undo bin/dev-link. Refuses to touch anything that is not a symlink back to
# this working tree, so a real installed copy is never deleted by accident.

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"

fail() {
  echo "dev-unlink: $*" >&2
  exit 1
}

id=$(jq -r '.id' "$ROOT/manifest.json")
target="$PLUGINS_DIR/$id"

[[ -L $target ]] || fail "$target is not a dev symlink; nothing to do"

current=$(readlink -f "$target")
[[ $current == "$ROOT" ]] || fail "$target points at $current, not this repo"

rm "$target"
omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

echo "dev-unlink: removed $target"
echo "dev-unlink: if it was in the bar, run 'omarchy plugin disable $id'"
